<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>pe.edu.nova.java</groupId>
        <artifactId>nova-bom</artifactId>
        <version>4.1.0</version>
    </parent>

    <artifactId>nova-quarkus-bom</artifactId>
    <packaging>pom</packaging>

    <name>Nova Platform Quarkus BOM</name>
    <description>BOM para proyectos Quarkus del meta-framework Nova. Importa el Quarkus upstream BOM (consenso del ecosistema: 3.33.3.3 LTS) y centraliza las versiones de las extensions internas Nova Platform.</description>

    <properties>
        <!-- Quarkus LTS branch adopted by Nova (single source of truth across parent,
             extensions, instances, demos). Override only if migrating the whole stack. -->
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <!-- 3.33.3.3 trae Netty 4.1.138 y Vert.x 4.5.34; la 3.33.2.1 traía versiones con
             CVE por encima de CVSS 7. -->
        <quarkus.platform.version>3.33.3.3</quarkus.platform.version>

        <!-- Internal Nova extensions. Versions are the canonical GH Packages coordinates. -->
        <!-- ADR-039: el artifactId deriva del repositorio. Hasta la 1.0.1 la extensión se
             publicó como nova-quarkus-api-ext; la 2.0.1 es la primera con este nombre. La 3.0.0
             trae los errores por capas de ADR-050. Última versión publicada, verificada el
             2026-10-01. -->
        <nova-api-standard-quarkus-extension.version>3.0.0</nova-api-standard-quarkus-extension.version>
        <!-- Capacidad de secretos (ADR-041 y ADR-049): la misma familia que gestiona nova-spring-boot-bom,
             con su extensión de Quarkus en lugar del starter. Todos sus artefactos salen con una sola
             versión. Última versión publicada, verificada el 2026-10-01. -->
        <nova-secrets.version>1.2.0</nova-secrets.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Upstream Quarkus BOM (consensus 3.33.3.3 LTS). -->
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Internal Nova Platform Quarkus extensions. Se gestionan por su módulo de runtime. El de
                 deployment (-deployment) no se declara: Quarkus lo resuelve desde el descriptor de la
                 extensión (deployment-artifact, en META-INF/quarkus-extension.properties), con la
                 misma versión que el runtime, así que no puede quedar desalineado.
                 Cuando este BOM gestione la meta-extensión nova-quarkus-extension (ADR-052, paso 3),
                 scripts/check_meta_completeness.py exigirá que traiga cada *-quarkus-extension de esta
                 lista, en la misma versión. -->
            <dependency>
                <groupId>pe.edu.nova.java.starters</groupId>
                <artifactId>nova-api-standard-quarkus-extension</artifactId>
                <version>${nova-api-standard-quarkus-extension.version}</version>
            </dependency>
            <!-- Capacidad de secretos (ADR-049). -->
            <dependency>
                <groupId>pe.edu.nova.java.libs</groupId>
                <artifactId>nova-secrets</artifactId>
                <version>${nova-secrets.version}</version>
            </dependency>
            <dependency>
                <groupId>pe.edu.nova.java.libs</groupId>
                <artifactId>nova-secrets-vault</artifactId>
                <version>${nova-secrets.version}</version>
            </dependency>
            <dependency>
                <groupId>pe.edu.nova.java.libs</groupId>
                <artifactId>nova-secrets-aws-secrets-manager</artifactId>
                <version>${nova-secrets.version}</version>
            </dependency>
            <dependency>
                <groupId>pe.edu.nova.java.starters</groupId>
                <artifactId>nova-secrets-quarkus-extension</artifactId>
                <version>${nova-secrets.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
