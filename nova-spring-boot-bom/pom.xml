<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>pe.edu.nova.java</groupId>
        <artifactId>nova-bom</artifactId>
        <version>2.1.0</version>
    </parent>

    <artifactId>nova-spring-boot-bom</artifactId>
    <packaging>pom</packaging>

    <name>Nova Platform Spring Boot BOM</name>
    <description>BOM para proyectos Spring Boot. Extiende el BOM raíz con versiones de Spring Boot y starters internos.</description>

    <properties>
        <!-- Spring Boot -->
        <spring-boot.version>4.0.8</spring-boot.version>
        <!-- Spring Boot 4.0.8 todavía fija Tomcat 11.0.24, que tiene CVE-2026-68525,
             CVE-2026-65905 y CVE-2026-65182 (corregidos en la 11.0.25). -->
        <tomcat.version>11.0.26</tomcat.version>
        <!-- La misma instrumentación con la que se construye nova-observability-spring-boot-starter
             (otelInstrumentationVersion en su build.gradle.kts). -->
        <opentelemetry-instrumentation.version>2.31.1</opentelemetry-instrumentation.version>
        <!-- Starters internos: artifactId según ADR-039. Últimas versiones publicadas,
             verificadas el 2026-09-30. -->
        <mask-utils-spring-boot-starter.version>2.0.0</mask-utils-spring-boot-starter.version>
        <api-standard-spring-boot-starter.version>2.0.0</api-standard-spring-boot-starter.version>
        <observability-spring-boot-starter.version>2.0.2</observability-spring-boot-starter.version>
        <nova-spring-boot-starter.version>1.0.4</nova-spring-boot-starter.version>
        <!-- Capacidad de secretos (ADR-041): nova-java-23-secrets publica sus cuatro artefactos con
             una sola versión, así que el BOM los gestiona con una sola propiedad. Última versión
             publicada, verificada el 2026-09-30. -->
        <nova-secrets.version>1.0.1</nova-secrets.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- BOM Raíz (Librerías) — Heredado vía parent -->
            <!-- Tomcat va antes del BOM de Spring Boot: una entrada propia manda sobre la
                 que llega por import, en Maven y en Gradle. -->
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-core</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-websocket</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-el</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <!-- OpenTelemetry va antes del BOM de Spring Boot. En Maven gana el primer import que
                 gestiona un artefacto, y Spring Boot 4.0.8 fija el núcleo de OpenTelemetry en 1.55.0,
                 mientras la instrumentación 2.31.1 necesita 1.65.0: sin este import, el starter de
                 observabilidad falla al arrancar con NoSuchFieldError. En Gradle gana la más alta. -->
            <dependency>
                <groupId>io.opentelemetry.instrumentation</groupId>
                <artifactId>opentelemetry-instrumentation-bom</artifactId>
                <version>${opentelemetry-instrumentation.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- BOM de Spring Boot -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Starters internos Nova Platform para Spring Boot (versiones literales
                 para evitar depender de la interpolación de properties del parent POM). -->
            <dependency>
                <groupId>pe.edu.nova.java.starters</groupId>
                <artifactId>nova-mask-spring-boot-starter</artifactId>
                <version>2.0.0</version>
            </dependency>
            <dependency>
                <groupId>pe.edu.nova.java.starters</groupId>
                <artifactId>nova-api-standard-spring-boot-starter</artifactId>
                <version>2.0.0</version>
            </dependency>
            <dependency>
                <groupId>pe.edu.nova.java.starters</groupId>
                <artifactId>nova-observability-spring-boot-starter</artifactId>
                <version>2.0.2</version>
            </dependency>
            <dependency>
                <groupId>pe.edu.nova.java.starters</groupId>
                <artifactId>nova-spring-boot-starter</artifactId>
                <version>1.0.4</version>
            </dependency>
            <!-- Capacidad de secretos (ADR-041, regla 5): los cuatro artefactos salen con la misma
                 versión y las entradas usan nova-secrets.version, no un literal. Con un literal la
                 propiedad no gestionaría nada, como le pasó a nova-spring-boot-starter en la 2.0.1.
                 La propiedad vive en este mismo POM, no en el padre. -->
            <dependency>
                <groupId>pe.edu.nova.java.libs</groupId>
                <artifactId>nova-secrets</artifactId>
                <version>${nova-secrets.version}</version>
            </dependency>
            <dependency>
                <groupId>pe.edu.nova.java.libs</groupId>
                <artifactId>nova-secrets-vault</artifactId>
                <version>${nova-secrets.version}</version>
            </dependency>
            <dependency>
                <groupId>pe.edu.nova.java.libs</groupId>
                <artifactId>nova-secrets-aws-secrets-manager</artifactId>
                <version>${nova-secrets.version}</version>
            </dependency>
            <dependency>
                <groupId>pe.edu.nova.java.starters</groupId>
                <artifactId>nova-secrets-spring-boot-starter</artifactId>
                <version>${nova-secrets.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
