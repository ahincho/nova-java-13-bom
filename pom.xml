<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>pe.edu.nova.java</groupId>
    <artifactId>nova-bom</artifactId>
    <version>4.1.0</version>
    <packaging>pom</packaging>

    <name>Nova Platform BOM</name>
    <description>BOM raíz que centraliza las versiones de las librerías puras de Nova Platform. Agnóstico al framework.</description>

    <modules>
        <module>nova-spring-boot-bom</module>
        <module>nova-quarkus-bom</module>
        <module>nova-micronaut-bom</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Versiones de librerías internas -->
        <!-- artifactId real = rootProject.name en cada settings.gradle.kts (NOVA-SEMVER-31: nombre repo != artifactId) -->
        <!-- Últimas versiones publicadas en GitHub Packages, verificadas el 2026-10-01. -->
        <mask-utils.version>1.1.2</mask-utils.version>
        <date-utils.version>1.0.2</date-utils.version>
        <mapper-utils.version>1.0.2</mapper-utils.version>
        <api-standard.version>1.1.0</api-standard.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Librerías internas Nova Platform (versiones literales para que Gradle
                 no dependa de la interpolación de properties del parent POM, que
                 no es 100% fiable cross-bom inheritance). -->
            <dependency>
                <groupId>pe.edu.nova.java.libs</groupId>
                <artifactId>nova-mask-utils</artifactId>
                <version>1.1.2</version>
            </dependency>
            <dependency>
                <groupId>pe.edu.nova.java.libs</groupId>
                <artifactId>nova-date-utils</artifactId>
                <version>1.0.2</version>
            </dependency>
            <dependency>
                <groupId>pe.edu.nova.java.libs</groupId>
                <artifactId>nova-mapper-utils</artifactId>
                <version>1.0.2</version>
            </dependency>
            <dependency>
                <groupId>pe.edu.nova.java.libs</groupId>
                <artifactId>nova-api-standard</artifactId>
                <version>1.1.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Distribution Management — GitHub Packages -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/ahincho/nova-java-13-bom</url>
        </repository>
    </distributionManagement>

</project>
